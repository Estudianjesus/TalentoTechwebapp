<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Programa de Salud Subsidiada</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        /* Custom styles */
        .header-container {
            position: relative;
            width: 100%;
            margin-bottom: 20px;
        }
        
        .header-image {
            width: 100%;
            height: 250px;
            background-image: url('/api/placeholder/1200/250');
            background-size: cover;
            background-position: center;
        }
        
        .navbar {
            background-color: rgba(13, 110, 253, 0.8); /* Semi-transparent blue */
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }
        
        .navbar-brand, .nav-link {
            color: white;
        }
        
        .nav-link:hover {
            color: rgba(255, 255, 255, 0.8);
        }
        
        .form-container {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }
        
        .left-panel {
            background-color: #f8f9fa;
            position: relative;
        }
        
        .left-panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('/api/placeholder/400/600');
            background-size: cover;
            opacity: 0.1;
            z-index: 0;
        }
        
        .form-panel {
            background-color: white;
            padding: 30px;
        }
        
        .form-title {
            color: #0d6efd;
            font-weight: bold;
        }
        
        .form-section {
            border-bottom: 1px solid #dee2e6;
            margin-bottom: 1rem;
        }
        
        .btn-submit {
            background-color: #0d6efd;
            color: white;
            padding: 10px 30px;
            border-radius: 30px;
            transition: all 0.3s;
        }
        
        .btn-submit:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <!-- Header Image with Navigation Overlay -->
    <div class="header-container">
        <div class="header-image"></div>
        <!-- Navigation Bar Overlay -->
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" href="#">Programa de Salud</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Afiliado</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
    
    <!-- Form Container -->
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-container row">
                    <!-- Left decorative panel -->
                    <div class="col-lg-4 left-panel d-flex align-items-center justify-content-center p-4">
                        <h2 class="text-primary fw-bold position-relative z-1">Programa de Salud Subsidiada</h2>
                    </div>
                    
                    <!-- Form panel -->
                    <div class="col-lg-8 form-panel">
                        <h1 class="form-title mb-4">Registro Subsidiado</h1>
                        
                        <form id="registroForm" method="POST" action="{{ url_for('portal_usuarios') }}">
                            <div class="row">
                                <!-- Tipo de documento y número -->
                                <div class="col-md-6 mb-3">
                                    <label for="tipo_documento" class="form-label fw-bold">Tipo de Documento</label>
                                    <select id="tipo_documento" class="form-select">
                                        <option value="" disabled selected>Seleccione una opción</option>
                                        <option value="cc">Cédula de Ciudadanía</option>
                                        <option value="ti">Tarjeta de Identidad</option>
                                        <option value="ce">Cédula de Extranjería</option>
                                        <option value="pp">Pasaporte</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="number" class="form-control" id="documentNumber" placeholder=" ">
                                        <label for="documentNumber">Número De Documento</label>
                                    </div>
                                </div>
                                
                                <!-- Fechas -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="date" class="form-control" id="fecha_expedicion" placeholder=" ">
                                        <label for="fecha_expedicion">Fecha de Expedición</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="date" class="form-control" id="fecha_nacimiento" placeholder=" ">
                                        <label for="fecha_nacimiento">Fecha de Nacimiento</label>
                                    </div>
                                </div>
                                
                  
                                <div class="col-12">
                                    <div class="form-section">
                                        <p class="fw-bold mb-3 text-primary">Información Personal</p>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="primer_apellido" placeholder=" ">
                                        <label for="primer_apellido">Primer Apellido</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="segundo_apellido" placeholder=" ">
                                        <label for="segundo_apellido">Segundo Apellido</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="primer_nombre" placeholder=" ">
                                        <label for="primer_nombre">Primer Nombre</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="segundo_nombre" placeholder=" ">
                                        <label for="segundo_nombre">Segundo Nombre</label>
                                    </div>
                                </div>
                                

                                <div class="col-12">
                                    <div class="form-section">
                                        <p class="fw-bold mb-3 text-primary">Información de Contacto</p>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="departamento" placeholder=" ">
                                        <label for="departamento">Departamento</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="direccion" placeholder=" ">
                                        <label for="direccion">Dirección</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="number" class="form-control" id="telefono" placeholder=" ">
                                        <label for="telefono">Teléfono</label>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="email" class="form-control" id="email" placeholder=" ">
                                        <label for="email">Email</label>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-section">
                                        <p class="fw-bold mb-3 text-primary">Información Adicional</p>
                                    </div>
                                </div>
                                
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Zona</label>
                                    <div class="d-flex gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="zona" id="zona_rural" value="rural">
                                            <label class="form-check-label" for="zona_rural">Rural</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="zona" id="zona_urbana" value="urbana">
                                            <label class="form-check-label" for="zona_urbana">Urbana</label>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Sexo del Afiliado</label>
                                    <div class="d-flex gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sexo" id="sexo_f" value="Femenino"> 
                                            <label class="form-check-label" for="sexo_f">Femenino</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sexo" id="sexo_m" value="Masculino"> 
                                            <label class="form-check-label" for="sexo_m">Masculino</label>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-4 mb-3">
                                    <label for="sisben" class="form-label fw-bold">¿Tiene ficha del SISBEN?</label>
                                    <select id="sisben" name="sisben" class="form-select">
                                        <option value="">Seleccione una opción</option>
                                        <option value="Grupo A">Grupo A</option>
                                        <option value="Grupo B">Grupo B</option>
                                        <option value="Grupo C">Grupo C</option>
                                    </select>
                                </div>
                                
                                <div class="col-12 mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="aceptarTerminos" required>
                                        <label class="form-check-label" for="aceptarTerminos">
                                            Acepto los <a href="#" data-bs-toggle="modal" data-bs-target="#modalTerminos">Términos y Condiciones</a>.
                                        </label>
                                    </div>
                                </div>
                                <input type="hidden" name="usuario_id" value="{{ usuario_id }}">
                                
                                <div class="col-12 d-flex justify-content-center mt-4">
                                    <button type="submit" class="btn btn-submit" id="but">
                                        <i class="bi bi-save me-2"></i> Guardar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal -->
    <div class="modal fade" id="modalTerminos" tabindex="-1" aria-labelledby="modalTerminosLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTerminosLabel">Términos y Condiciones</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Aquí puedes escribir los términos y condiciones...</p>
                    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla facilisi. Donec tincidunt...</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>